Bootstrap: docker
From: python:3.11

# BornAgain 24.x (latest on PyPI: 24.1) + scipp/scippneutron for mcstas_gisans
# (the image /users/milan.klausz/rt_181019/bornagain_v24_scipp_apptainer.sif on the DMSC cluster).
# Same package list as bornagain_v23.0_scipp_apptainer.def (bornagain numpy scipy mcpl tqdm h5py,
# matplotlib/pillow as their deps, scipp and scippneutron); bornagain pinned to 24.1, everything
# else the latest compatible release at build time (build_image_sandbox.sh writes the exact
# versions to a *_pip_freeze.txt next to the .sif). BornAgain 24 additionally pulls in vtk.
# mcstas_gisans itself is not installed in the image: put its src directory on PYTHONPATH
# (see doc/source/dmsc_cluster.rst).
# Definition file version: 261007
#
# Build (needs root, x86_64 Linux):
#   sudo singularity build bornagain_v24_scipp_apptainer.sif bornagain_v24_scipp_apptainer.def
# Without root (e.g. on the DMSC cluster login node), see build_image_sandbox.sh:
#   sandbox from docker -> pip install in the writable sandbox -> SIF.

%post
    pip install --no-cache-dir --root-user-action=ignore \
        bornagain==24.1 numpy scipy matplotlib h5py mcpl pillow tqdm scipp scippneutron

%test
    MPLCONFIGDIR=/tmp python -c "import bornagain, numpy, scipy, matplotlib, h5py, mcpl, tqdm, PIL, scipp, scippneutron, scippnexus; print('BornAgain', bornagain.version_str, 'numpy', numpy.__version__, 'scipp', scipp.__version__, 'scippneutron', scippneutron.__version__)"

%labels
    Software BornAgain 24.1 + scipp + scippneutron
